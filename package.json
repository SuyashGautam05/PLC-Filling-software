{
  "name": "mes-training-workbench",
  "productName": "Manufacturing Execution System (MES) Training WorkBench",
  "version": "1.0.0",
  "description": "Electron HMI for the filling machine...",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder"
  },
  "author": "STPL",
  "license": "MIT",
  "dependencies": {
    "modbus-serial": "^8.0.16"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.scientech.mestrainingworkbench",
    "productName": "Manufacturing Execution System (MES) Training WorkBench",
    "directories": {
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "scripts/**/*",
      "package.json",
      "!scripts/training_data/**",
      "!scripts/training_data_fill/**",
      "!scripts/__pycache__/**",
      "!scripts/dist/**",
      "!scripts/build/**",
      "!scripts/analyze_box.spec"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "scripts/dist/analyze_box",
        "to": "analyze_box"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "shortcutName": "MES Training WorkBench",
      "uninstallDisplayName": "MES Training WorkBench",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}